root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,mjs,cjs,json,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4

[*.{toml}]
indent_style = space
indent_size = 2

# Markdown 里的行尾空格是有意义的（强制换行），不要自动清除
[*.md]
trim_trailing_whitespace = false

# Windows 脚本与批处理必须用 CRLF，否则 cmd.exe 解析异常
[*.{cmd,bat,ps1}]
end_of_line = crlf
